---
source: crates/jsonschema-macros-core/src/tests.rs
description: "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"additionalItems\":{\"type\":\"string\"},\"items\":[{\"type\":\"integer\"}],\"type\":\"array\"}"
expression: errors_body(schema)
---
match instance {
            __Value::Array(arr) => {
                if let Some(instance) = arr.get(0usize) {
                    if !(match instance {
                        __Value::Number(n) => __types::is_integer(n),
                        _ => false,
                    }) {
                        let __path = &__path.push(0usize);
                        if !(match instance {
                            __Value::Number(n) => __types::is_integer(n),
                            _ => false,
                        }) {
                            if __errors
                                .push(
                                    __err::single_type(
                                        "/items/0/type",
                                        __path.into(),
                                        instance,
                                        __JT::Integer,
                                    ),
                                )
                            {
                                return true;
                            }
                        }
                    }
                }
                for (idx, item) in arr.iter().enumerate().skip(1usize) {
                    let instance = item;
                    let __path = &__path.push(idx);
                    if !(instance.is_string()) {
                        if __errors
                            .push(
                                __err::single_type(
                                    "/additionalItems/type",
                                    __path.into(),
                                    instance,
                                    __JT::String,
                                ),
                            )
                        {
                            return true;
                        }
                    }
                }
            }
            _ => {
                if __errors
                    .push(
                        __err::single_type("/type", __path.into(), instance, __JT::Array),
                    )
                {
                    return true;
                }
            }
        }
        false
