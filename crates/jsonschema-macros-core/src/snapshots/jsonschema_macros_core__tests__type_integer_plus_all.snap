expression: errors_body(schema)
---
if !(match instance {
            __Value::Number(n) => __types::is_integer(n),
            __Value::String(_) => true,
            __Value::Bool(_) => true,
            __Value::Null => true,
            __Value::Array(_) => true,
            __Value::Object(_) => true,
            _ => false,
        }) {
            if __errors
                .push(
                    __err::multiple_types(
                        "/type",
                        __path.into(),
                        instance,
                        __JTS::empty()
                            .insert(__JT::Integer)
                            .insert(__JT::String)
                            .insert(__JT::Boolean)
                            .insert(__JT::Null)
                            .insert(__JT::Array)
                            .insert(__JT::Object),
                    ),
                )
            {
                return true;
            }
        }
        false
