---
source: crates/jsonschema-macros-core/src/tests.rs
description: "{\"$schema\":\"http://json-schema.org/draft-06/schema#\",\"maxItems\":1.5e+2,\"type\":\"array\"}"
expression: errors_body(schema)
---
match instance {
            __Value::Array(arr) => {
                if !((arr.len() as u64) <= 150) {
                    if __errors
                        .push(
                            __err::max_items("/maxItems", __path.into(), instance, 150),
                        )
                    {
                        return true;
                    }
                }
            }
            _ => {
                if __errors
                    .push(
                        __err::single_type("/type", __path.into(), instance, __JT::Array),
                    )
                {
                    return true;
                }
            }
        }
        false
