---
source: crates/jsonschema-macros-core/src/tests.rs
description: "{\"additionalProperties\":{\"type\":\"integer\"},\"properties\":{\"a\":{}},\"type\":\"object\"}"
expression: errors_body(schema)
---
match instance {
            __Value::Object(obj) => {
                for (key, value) in obj.iter() {
                    let key_str = key.as_str();
                    match key_str {
                        "a" => {}
                        _ => {
                            let instance = value;
                            let __path = &__path.push(key_str);
                            if !(match instance {
                                __Value::Number(n) => __types::is_integer(n),
                                _ => false,
                            }) {
                                if __errors
                                    .push(
                                        __err::single_type(
                                            "/additionalProperties/type",
                                            __path.into(),
                                            instance,
                                            __JT::Integer,
                                        ),
                                    )
                                {
                                    return true;
                                }
                            }
                        }
                    }
                }
            }
            _ => {
                if __errors
                    .push(
                        __err::single_type(
                            "/type",
                            __path.into(),
                            instance,
                            __JT::Object,
                        ),
                    )
                {
                    return true;
                }
            }
        }
        false
