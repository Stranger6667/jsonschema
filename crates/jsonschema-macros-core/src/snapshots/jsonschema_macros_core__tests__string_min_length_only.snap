match instance {
            __Value::String(s) => {
                if !((s.chars().count() as u64) >= 3) {
                    if __errors
                        .push(
                            __err::min_length("/minLength", __path.into(), instance, 3),
                        )
                    {
                        return true;
                    }
                }
            }
            _ => {
                if __errors
                    .push(
                        __err::single_type(
                            "/type",
                            __path.into(),
                            instance,
                            __JT::String,
                        ),
                    )
                {
                    return true;
                }
            }
        }
        false
