---
source: crates/jsonschema-macros-core/src/tests.rs
description: "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"items\":[true,{\"type\":\"integer\"}],\"type\":\"array\"}"
expression: errors_body(schema)
---
match instance {
            __Value::Array(arr) => {
                if let Some(instance) = arr.get(1usize) {
                    if !(match instance {
                        __Value::Number(n) => __types::is_integer(n),
                        _ => false,
                    }) {
                        let __path = &__path.push(1usize);
                        if !(match instance {
                            __Value::Number(n) => __types::is_integer(n),
                            _ => false,
                        }) {
                            if __errors
                                .push(
                                    __err::single_type(
                                        "/items/1/type",
                                        __path.into(),
                                        instance,
                                        __JT::Integer,
                                    ),
                                )
                            {
                                return true;
                            }
                        }
                    }
                }
            }
            _ => {
                if __errors
                    .push(
                        __err::single_type("/type", __path.into(), instance, __JT::Array),
                    )
                {
                    return true;
                }
            }
        }
        false
