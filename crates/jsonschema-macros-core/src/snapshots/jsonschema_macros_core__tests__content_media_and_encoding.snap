---
source: crates/jsonschema-macros-core/src/tests.rs
description: "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"contentEncoding\":\"base64\",\"contentMediaType\":\"application/json\",\"type\":\"string\"}"
expression: errors_body(schema)
---
match instance {
            __Value::String(s) => {
                if let Some(__e) = '__first_error: {
                    match __content::from_base64(s) {
                        Ok(Some(__decoded)) => {
                            if !__content::is_json(&__decoded) {
                                break '__first_error Some(
                                    __err::content_media_type(
                                        "/contentMediaType",
                                        __path.into(),
                                        instance,
                                        "application/json",
                                    ),
                                );
                            }
                        }
                        Ok(None) => {
                            break '__first_error Some(
                                __err::content_encoding(
                                    "/contentEncoding",
                                    __path.into(),
                                    instance,
                                    "base64",
                                ),
                            );
                        }
                        Err(__err) => {
                            break '__first_error Some(
                                __err::content_conversion(
                                    "/contentEncoding",
                                    __path.into(),
                                    instance,
                                    __err,
                                ),
                            );
                        }
                    }
                    None
                } {
                    if __errors.push(__e) {
                        return true;
                    }
                }
            }
            _ => {
                if __errors
                    .push(
                        __err::single_type(
                            "/type",
                            __path.into(),
                            instance,
                            __JT::String,
                        ),
                    )
                {
                    return true;
                }
            }
        }
        false
