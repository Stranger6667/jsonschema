---
source: crates/jsonschema-macros-core/src/tests.rs
description: "{\"minimum\":0,\"type\":[\"number\",\"string\",\"boolean\",\"null\",\"array\",\"object\"]}"
expression: errors_body(schema)
---
match instance {
            __Value::Number(n) => {
                if !(__num::ge(n, 0u64)) {
                    if __errors
                        .push(
                            __err::minimum(
                                "/minimum",
                                __path.into(),
                                instance,
                                __sj::Value::Number(__sj::Number::from(0u64)),
                            ),
                        )
                    {
                        return true;
                    }
                }
            }
            __Value::String(_) => {}
            __Value::Array(_) => {}
            __Value::Object(_) => {}
            __Value::Bool(_) => {}
            __Value::Null => {}
            _ => {
                if __errors
                    .push(
                        __err::multiple_types(
                            "/type",
                            __path.into(),
                            instance,
                            __JTS::empty()
                                .insert(__JT::Number)
                                .insert(__JT::String)
                                .insert(__JT::Boolean)
                                .insert(__JT::Null)
                                .insert(__JT::Array)
                                .insert(__JT::Object),
                        ),
                    )
                {
                    return true;
                }
            }
        }
        false
