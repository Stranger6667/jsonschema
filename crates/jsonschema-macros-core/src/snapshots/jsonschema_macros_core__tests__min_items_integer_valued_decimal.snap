---
source: crates/jsonschema-macros-core/src/tests.rs
description: "{\"$schema\":\"http://json-schema.org/draft-06/schema#\",\"minItems\":2.0,\"type\":\"array\"}"
expression: errors_body(schema)
---
match instance {
            __Value::Array(arr) => {
                if !((arr.len() as u64) >= 2) {
                    if __errors
                        .push(__err::min_items("/minItems", __path.into(), instance, 2))
                    {
                        return true;
                    }
                }
            }
            _ => {
                if __errors
                    .push(
                        __err::single_type("/type", __path.into(), instance, __JT::Array),
                    )
                {
                    return true;
                }
            }
        }
        false
