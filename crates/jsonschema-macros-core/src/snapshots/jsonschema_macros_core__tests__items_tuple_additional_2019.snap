                                        __path.into(),
                                        instance,
                                        __JT::Integer,
                                    ),
                                )
                            {
                                return true;
                            }
                        }
                    }
                }
                for (idx, item) in arr.iter().enumerate().skip(1usize) {
                    let instance = item;
                    let __path = &__path.push(idx);
                    if !(instance.is_string()) {
                        if __errors
                            .push(
                                __err::single_type(
                                    "/additionalItems/type",
                                    __path.into(),
                                    instance,
                                    __JT::String,
                                ),
                            )
                        {
                            return true;
                        }
                    }
                }
                if let Some(__e) = (|| -> Option<__VE<'_>> {
                    if let __Value::Array(arr) = instance {
                        let mut __unexpected: Vec<String> = Vec::new();
                        for (idx, item) in arr.iter().enumerate() {
                            if !(true) && !(false) {
                                __unexpected.push(item.to_string());
                            }
                        }
                        if !__unexpected.is_empty() {
                            return Some(
                                __err::unevaluated_items(
                                    "/unevaluatedItems",
                                    __path.into(),
                                    instance,
                                    __unexpected,
                                ),
                            );
                        }
                    }
                    None
                })() {
                    if __errors.push(__e) {
                        return true;
                    }
                }
            }
            _ => {
                if __errors
                    .push(
                        __err::single_type("/type", __path.into(), instance, __JT::Array),
                    )
