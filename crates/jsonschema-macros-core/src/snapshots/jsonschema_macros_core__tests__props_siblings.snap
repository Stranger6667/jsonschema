---
source: crates/jsonschema-macros-core/src/tests.rs
description: "{\"additionalProperties\":{\"type\":\"boolean\"},\"patternProperties\":{\"^x_\":{\"type\":\"string\"}},\"properties\":{\"a\":{\"type\":\"integer\"}},\"type\":\"object\",\"unevaluatedProperties\":false}"
expression: errors_body(schema)
---
match instance {
            __Value::Object(obj) => {
                for (key, value) in obj.iter() {
                    let key_str = key.as_str();
                    let mut covered = false;
                    match key_str {
                        "a" => {
                            let instance = value;
                            let __path = &__path.push("a");
                            if !(match instance {
                                __Value::Number(n) => __types::is_integer(n),
                                _ => false,
                            }) {
                                if __errors
                                    .push(
                                        __err::single_type(
                                            "/properties/a/type",
                                            __path.into(),
                                            instance,
                                            __JT::Integer,
                                        ),
                                    )
                                {
                                    return true;
                                }
                            }
                            covered = true;
                        }
                        _ => {}
                    }
                    if key.as_str().starts_with("x_") {
                        let instance = value;
                        let __path = &__path.push(key_str);
                        if !(instance.is_string()) {
                            if __errors
                                .push(
                                    __err::single_type(
                                        "/patternProperties/^x_/type",
                                        __path.into(),
                                        instance,
                                        __JT::String,
                                    ),
                                )
                            {
                                return true;
                            }
                        }
                        covered = true;
                    }
                    if !covered {
                        let instance = value;
                        let __path = &__path.push(key_str);
                        if !(instance.is_boolean()) {
                            if __errors
                                .push(
                                    __err::single_type(
                                        "/additionalProperties/type",
                                        __path.into(),
                                        instance,
                                        __JT::Boolean,
                                    ),
                                )
                            {
                                return true;
                            }
                        }
                    }
                }
            }
            _ => {
                if __errors
                    .push(
                        __err::single_type(
                            "/type",
                            __path.into(),
                            instance,
                            __JT::Object,
                        ),
                    )
                {
                    return true;
                }
            }
        }
        false
