[
  {
    "description": "ir: additionalProperties:false with named keys folds into propertyNames",
    "schemas": [
      {
        "type": "object",
        "properties": {
          "a": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "a": {
            "type": "string"
          }
        },
        "propertyNames": {
          "const": "a"
        }
      },
      {
        "type": "object",
        "properties": {
          "a": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1
        }
      }
    ],
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "propertyNames": {
        "const": "a"
      },
      "properties": {
        "a": {
          "type": "string"
        }
      }
    },
    "tests": [
      {
        "data": {
          "a": "x"
        },
        "valid": true
      },
      {
        "data": {
          "a": 1
        },
        "valid": false
      },
      {
        "data": {
          "b": "x"
        },
        "valid": false
      },
      {
        "data": {},
        "valid": true
      }
    ]
  },
  {
    "description": "ir: additionalProperties:false with a pattern folds into propertyNames",
    "schemas": [
      {
        "type": "object",
        "patternProperties": {
          "^a": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "patternProperties": {
          "^a": {
            "type": "integer"
          }
        },
        "propertyNames": {
          "pattern": "^a"
        }
      }
    ],
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^a"
      },
      "patternProperties": {
        "^a": {
          "type": "integer"
        }
      }
    },
    "tests": [
      {
        "data": {
          "ab": 1
        },
        "valid": true
      },
      {
        "data": {
          "ab": "x"
        },
        "valid": false
      },
      {
        "data": {
          "b": 1
        },
        "valid": false
      },
      {
        "data": {},
        "valid": true
      }
    ]
  },
