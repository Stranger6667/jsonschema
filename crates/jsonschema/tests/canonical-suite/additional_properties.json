  {
    "description": "intersecting objects naming different keys meets each key with the other side's additionalProperties",
    "schema": {
      "allOf": [
        {
          "type": "object",
          "properties": {
            "a": {"type": "integer"},
            "c": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": {"type": "integer", "minimum": 5}
        },
        {
          "type": "object",
          "properties": {
            "b": {"type": "integer"},
            "d": {"type": "integer", "maximum": 10}
          },
          "additionalProperties": {"type": "integer", "maximum": 100}
        }
      ]
    },
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "a": {"type": "integer", "maximum": 100},
        "b": {"type": "integer", "minimum": 5},
        "c": {"type": "integer", "minimum": 0, "maximum": 100},
        "d": {"type": "integer", "minimum": 5, "maximum": 10}
      },
      "additionalProperties": {"type": "integer", "minimum": 5, "maximum": 100}
    },
    "tests": [
      {"data": {"a": 50, "b": 5, "c": 0, "d": 10, "x": 100}, "valid": true},
      {"data": {"a": 101}, "valid": false},
      {"data": {"b": 4}, "valid": false},
      {"data": {"c": -1}, "valid": false},
      {"data": {"d": 11}, "valid": false},
      {"data": {"x": 4}, "valid": false},
      {"data": {"x": 101}, "valid": false},
      {"data": {"x": "s"}, "valid": false}
    ]
  },
