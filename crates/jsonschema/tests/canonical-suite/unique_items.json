    "schema": {"type": "array", "contains": {"type": "null"}, "minContains": 2, "uniqueItems": true},
    "expected": {"$schema": "https://json-schema.org/draft/2020-12/schema", "not": {}},
    "satisfiable": false
  },
  {
    "description": "ir: a boolean contains domain under uniqueItems cannot meet minContains 3",
    "schema": {"type": "array", "contains": {"type": "boolean"}, "minContains": 3, "uniqueItems": true},
    "expected": {"$schema": "https://json-schema.org/draft/2020-12/schema", "not": {}},
    "satisfiable": false
  },
