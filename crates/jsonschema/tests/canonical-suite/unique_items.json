      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "array",
      "contains": {"const": "A"},
      "minContains": 2
    },
    "satisfiable": true,
    "tests": [
      {"data": ["A", "A"], "valid": true},
      {"data": ["A"], "valid": false}
    ]
  },
