      "type": "array",
      "contains": {"type": "string"},
      "minContains": 99,
      "uniqueItems": true
    },
    "satisfiable": true,
    "tests": [
      {"data": ["a"], "valid": false}
    ]
  },
  {
    "description": "ir: a window of at most one item drops into a wider one demanding distinctness",
    "schema": {"anyOf": [
      {"type": "array", "maxItems": 1, "prefixItems": [{"type": "array"}]},
      {"type": "array", "maxItems": 4, "uniqueItems": true}
    ]},
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true
    },
    "satisfiable": true,
    "tests": [
