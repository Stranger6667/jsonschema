[
  {
    "description": "a lone $dynamicAnchor asserts nothing",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$dynamicAnchor": "meta",
      "type": "string"
    },
    "kind": "multi_type",
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string"
    },
    "tests": [
      {
        "data": "x",
        "valid": true
      },
      {
        "data": 1,
        "valid": false
      }
    ]
  },
  {
    "description": "a lone $recursiveAnchor asserts nothing",
    "schema": {
      "$schema": "https://json-schema.org/draft/2019-09/schema",
      "$recursiveAnchor": true,
      "type": "integer"
    },
    "kind": "multi_type",
    "expected": {
      "$schema": "https://json-schema.org/draft/2019-09/schema",
      "type": "integer"
    },
    "tests": [
      {
        "data": 1,
        "valid": true
      },
      {
        "data": "1",
        "valid": false
      }
    ]
  },
  {
    "description": "$ref and $dynamicAnchor are independent of order - $defs first",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://test.json-schema.org/ref-and-dynamic-anchor/root",
      "$defs": {
        "inner": {
          "$id": "inner",
          "$dynamicAnchor": "foo",
          "title": "inner",
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "$ref": "inner",
      "$dynamicAnchor": "foo"
    },
    "kind": "reference",
    "expected": {
      "$defs": {
        "urn:jsonschema:canonical:https%3A%2F%2Ftest.json-schema.org%2Fref-and-dynamic-anchor%2Finner": {
          "anyOf": [
            {
              "type": [
                "null",
                "boolean",
                "number",
                "string",
                "array"
              ]
            },
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            }
          ]
        }
      },
      "$ref": "#/$defs/urn:jsonschema:canonical:https%253A%252F%252Ftest.json-schema.org%252Fref-and-dynamic-anchor%252Finner",
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "tests": [
      {
        "data": {
          "a": 1
        },
        "valid": true
      },
      {
        "data": {
          "a": "one"
        },
        "valid": false
      }
    ]
  },
  {
    "description": "a $dynamicRef without a matching $dynamicAnchor behaves like a normal $ref to an $anchor",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://test.json-schema.org/dynamic-ref-no-anchor/root",
      "$ref": "#/$defs/used",
      "$defs": {
        "inner": {
          "$anchor": "foo",
          "type": "string"
        },
        "used": {
          "$dynamicRef": "#foo"
        }
      }
    },
    "tests": [
      {
        "data": "x",
        "valid": true
      },
      {
        "data": 1,
        "valid": false
      }
    ],
    "expected": {
      "$defs": {
        "urn:jsonschema:canonical:https%3A%2F%2Ftest.json-schema.org%2Fdynamic-ref-no-anchor%2Froot%23foo": {
          "type": "string"
        },
        "used": {
          "$ref": "#/$defs/urn:jsonschema:canonical:https%253A%252F%252Ftest.json-schema.org%252Fdynamic-ref-no-anchor%252Froot%2523foo"
        }
      },
      "$ref": "#/$defs/used",
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  {
    "description": "a $dynamicRef resolves to the first $dynamicAnchor still in scope",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://test.json-schema.org/typical-dynamic-resolution/root",
      "$ref": "list",
      "$defs": {
        "foo": {
          "$dynamicAnchor": "items",
          "type": "string"
        },
        "list": {
          "$id": "list",
          "type": "array",
          "items": {
            "$dynamicRef": "#items"
          },
          "$defs": {
            "items": {
              "$comment": "Only needed to satisfy the bookending requirement",
              "$dynamicAnchor": "items"
            }
          }
        }
      }
    },
    "tests": [
      {
        "data": [
          "a",
          "b"
        ],
        "valid": true
      },
      {
        "data": [
          "a",
          1
        ],
        "valid": false
      },
      {
        "data": [],
        "valid": true
      }
    ],
    "expected": {
      "$defs": {
        "urn:jsonschema:canonical:https%3A%2F%2Ftest.json-schema.org%2Ftypical-dynamic-resolution%2Flist%23items%7Cdyn%3Ditems%40https%3A%2F%2Ftest.json-schema.org%2Ftypical-dynamic-resolution%2Froot": {
          "type": "string"
        },
        "urn:jsonschema:canonical:https%3A%2F%2Ftest.json-schema.org%2Ftypical-dynamic-resolution%2Flist%7Cdyn%3Ditems%40https%3A%2F%2Ftest.json-schema.org%2Ftypical-dynamic-resolution%2Froot": {
          "items": {
            "$ref": "#/$defs/urn:jsonschema:canonical:https%253A%252F%252Ftest.json-schema.org%252Ftypical-dynamic-resolution%252Flist%2523items%257Cdyn%253Ditems%2540https%253A%252F%252Ftest.json-schema.org%252Ftypical-dynamic-resolution%252Froot"
