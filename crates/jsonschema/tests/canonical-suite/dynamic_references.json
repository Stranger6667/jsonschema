          "type": "array"
        }
      },
      "$ref": "#/$defs/urn:jsonschema:canonical:https%253A%252F%252Ftest.json-schema.org%252Ftypical-dynamic-resolution%252Flist%257Cdyn%253Ditems%2540https%253A%252F%252Ftest.json-schema.org%252Ftypical-dynamic-resolution%252Froot",
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
