  {
    "description": "$recursiveRef without $recursiveAnchor works like $ref",
    "schema": {
      "$schema": "https://json-schema.org/draft/2019-09/schema",
      "$id": "https://test.json-schema.org/recursive-ref-without-anchor/root",
      "$ref": "#/$defs/myobject",
      "$defs": {
        "myobject": {
          "$id": "myobject.json",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "$recursiveRef": "#"
              }
            }
          ]
        }
      }
    },
    "tests": [
      {
        "data": "foo",
        "valid": true
      },
      {
        "data": {
          "foo": "bar"
        },
        "valid": true
      },
      {
        "data": {
          "foo": {
            "bar": "baz"
          }
        },
        "valid": true
      },
      {
        "data": {
          "foo": 1
        },
        "valid": false
      }
    ],
    "expected": {
      "$defs": {
        "myobject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/urn:jsonschema:canonical:https%253A%252F%252Ftest.json-schema.org%252Frecursive-ref-without-anchor%252Fmyobject.json%2523"
              },
              "type": "object"
            }
          ]
        },
        "urn:jsonschema:canonical:https%3A%2F%2Ftest.json-schema.org%2Frecursive-ref-without-anchor%2Fmyobject.json%23": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/urn:jsonschema:canonical:https%253A%252F%252Ftest.json-schema.org%252Frecursive-ref-without-anchor%252Fmyobject.json%2523"
