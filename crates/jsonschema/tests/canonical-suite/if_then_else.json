 {"kind": {"const": "k12"}}, "required": ["kind"]}, "then": {"type": "object", "properties": {"f12": {"type": "string"}}}}, {"if": {"type": "object", "properties": {"kind": {"const": "k13"}}, "required": ["kind"]}, "then": {"type": "object", "properties": {"f13": {"type": "string"}}}}, {"if": {"type": "object", "properties": {"kind": {"const": "k14"}}, "required": ["kind"]}, "then": {"type": "object", "properties": {"f14": {"type": "string"}}}}, {"if": {"type": "object", "properties": {"kind": {"const": "k15"}}, "required": ["kind"]}, "then": {"type": "object", "properties": {"f15": {"type": "string"}}}}, {"if": {"type": "object", "properties": {"kind": {"const": "k16"}}, "required": ["kind"]}, "then": {"type": "object", "properties": {"f16": {"type": "string"}}}}, {"if": {"type": "object", "properties": {"kind": {"const": "k17"}}, "required": ["kind"]}, "then": {"type": "object", "properties": {"f17": {"type": "string"}}}}, {"if": {"type": "object", "properties": {"kind": {"const": "k18"}}, "required": ["kind"]}, "then": {"type": "object", "properties": {"f18": {"type": "string"}}}}, {"if": {"type": "object", "properties": {"kind": {"const": "k19"}}, "required": ["kind"]}, "then": {"type": "object", "properties": {"f19": {"type": "string"}}}}]},
