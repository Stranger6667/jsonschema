[
  {
    "description": "number intersect multitype with integer is not empty - admits an integer value",
    "schema": {
      "allOf": [
        {
          "type": "number"
        },
        {
          "type": [
            "null",
            "integer"
          ]
        }
      ]
    },
    "tests": [
      {
        "data": 0,
        "valid": true
      }
    ],
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "integer"
    }
  },
  {
    "description": "ir_typed_value_set_with_conflicting_type_is_empty",
    "schema": {
      "allOf": [
        {
          "type": "null"
        },
        {
          "const": 1
        }
      ]
    },
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "not": {}
    }
  },
  {
    "description": "ir_allof_conflicting_types_collapses_to_false",
    "schema": {
      "allOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "not": {}
    }
  },
  {
    "description": "ir_trivial_allof_false_short_circuits",
    "schema": {
      "allOf": [
        false,
        {
          "type": "integer"
        }
      ]
    },
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "not": {}
    }
  },
  {
    "description": "integer_subtype_of_number_empty integer_and_string_disjoint",
    "draft": "draft7",
    "schema": {
      "allOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "expected": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "not": {}
    }
  },
  {
    "description": "type_pin_simplification_empty null_const_zero_disjoint",
    "draft": "draft7",
    "schema": {
      "allOf": [
        {
          "type": "null"
        },
        {
          "const": 0
        }
      ]
    },
    "expected": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "not": {}
    }
  },
  {
    "description": "type_pin_simplification_empty null_enum_no_null_disjoint",
    "draft": "draft7",
    "schema": {
      "allOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            0,
            "a",
            true
          ]
        }
      ]
    },
    "expected": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "not": {}
    }
  },
  {
    "description": "ir: an empty not converges with the false schema",
    "schemas": [
      {
        "not": {}
      },
      false
    ],
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "not": {}
    },
    "satisfiable": false,
    "tests": [
      {
        "data": 1,
        "valid": false
      },
      {
        "data": {},
        "valid": false
      }
    ]
  },
  {
    "description": "ir: an empty not is the false schema under draft 4",
    "schema": {
      "not": {}
    },
    "draft": "draft4",
    "expected": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "not": {}
    },
    "satisfiable": false,
    "tests": [
      {
        "data": 1,
        "valid": false
      }
    ]
  },
  {
    "description": "a type set holds values of its own",
    "schema": {
      "type": "string"
    },
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string"
    },
    "satisfiability": "yes"
  },
  {
    "description": "a length window holds strings",
    "schema": {
      "type": "string",
      "minLength": 2
    },
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "minLength": 2
    },
    "satisfiability": "yes"
  },
  {
    "description": "an object window holds the empty object",
    "schema": {
      "type": "object",
      "properties": {
        "a": false
      }
    },
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "a": false
      }
    },
    "satisfiability": "yes"
  },
  {
    "description": "a value is built from a pattern anchored at the start",
    "schema": {
      "type": "string",
      "pattern": "^a"
    },
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "pattern": "^a"
    },
    "satisfiability": "yes"
  },
  {
    "description": "a contradiction folds to nothing",
    "schema": {
      "type": "integer",
      "minimum": 10,
      "maximum": 5
    },
    "expected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "not": {}
    },
    "satisfiability": "no"
  }
]
