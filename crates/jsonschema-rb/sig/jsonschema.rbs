# Type signatures for the jsonschema_rs gem

module JSONSchema
  VERSION: String

  # Draft identifiers that `Resolved#draft` returns.
  Draft4: Integer
  Draft6: Integer
  Draft7: Integer
  Draft201909: Integer
  Draft202012: Integer

  # Valid draft version symbols
  type draft = :draft4 | :draft6 | :draft7 | :draft201909 | :draft202012

  module Canonical
    module JSON
      # Serialize a Ruby value to canonical JSON.
      #
      # Main use case: deduplicate equivalent JSON Schemas by using a stable string form.
      def self.to_string: (untyped object) -> String
    end

    # Structural discriminant of a canonical schema, one per view class.
    type kind = :multi_type | :typed_group | :string | :integer | :number | :array
              | :object | :const | :enum | :not | :all_of | :any_of | :one_of
              | :reference | :true | :false | :raw

    # What an array requires of its elements: all distinct, some repeated, or neither.
    type distinctness = :unconstrained | :all_distinct | :some_repeated

    # Why canonicalization kept a schema verbatim.
    type raw_reason = :unknown_dialect | :unmodeled | :outgrew_intersections
                    | :outgrew_cases | :inexact_intersection

    # Whether one schema accepts every value another does. Only `:yes` proves containment: test
    # for `:yes`, and treat `:unknown` like `:no`.
    type containment = :yes | :no | :unknown

    # Whether any value satisfies a schema. Only `:no` proves it accepts nothing: test for `:no`,
    # and treat `:unknown` like `:yes`.
    type satisfiability = :yes | :no | :unknown

    type view = TrueView | FalseView | MultiTypeView | TypedGroupView | StringView
              | IntegerView | NumberView | ArrayView | ObjectView | NotView
              | AllOfView | AnyOfView | OneOfView | ReferenceView | ConstView
              | EnumView | RawView

    module Containment
      YES: :yes
      NO: :no
      UNKNOWN: :unknown
      ALL: Array[containment]
    end

    module Satisfiability
      YES: :yes
      NO: :no
      UNKNOWN: :unknown
      ALL: Array[satisfiability]
    end

    module Distinctness
      UNCONSTRAINED: :unconstrained
      ALL_DISTINCT: :all_distinct
      SOME_REPEATED: :some_repeated
      ALL: Array[distinctness]
    end

    module RawReason
      UNKNOWN_DIALECT: :unknown_dialect
      UNMODELED: :unmodeled
      OUTGREW_INTERSECTIONS: :outgrew_intersections
      OUTGREW_CASES: :outgrew_cases
      INEXACT_INTERSECTION: :inexact_intersection
      ALL: Array[raw_reason]
    end

    module Kind
      MULTI_TYPE: :multi_type
      TYPED_GROUP: :typed_group
      STRING: :string
      INTEGER: :integer
      NUMBER: :number
      ARRAY: :array
      OBJECT: :object
      CONST: :const
      ENUM: :enum
      NOT: :not
      ALL_OF: :all_of
      ANY_OF: :any_of
      ONE_OF: :one_of
      REFERENCE: :reference
      TRUE: :true
      FALSE: :false
      RAW: :raw
      ALL: Array[kind]
    end

    class CanonicalizationError < StandardError
    end

    class InvalidSchemaType < CanonicalizationError
    end

    class InvalidPattern < CanonicalizationError
    end

    class IncompatibleOperands < CanonicalizationError
    end

    class UnsupportedOperand < CanonicalizationError
    end

    class UnsupportedResult < CanonicalizationError
    end

    # A schema reduced to canonical form; many schemas accepting the same values share one.
    class CanonicalSchema
      def to_json_schema: () -> untyped
      def draft: () -> JSONSchema::draft
      def kind: () -> kind
      def view: () -> view
      def intersect: (CanonicalSchema other) -> CanonicalSchema
      def union: (CanonicalSchema other) -> CanonicalSchema
      def subtract: (CanonicalSchema other) -> CanonicalSchema
      def covers: (CanonicalSchema other) -> containment
      def negate: () -> CanonicalSchema
      def definition: (String uri) -> CanonicalSchema?
      def definitions: () -> Hash[String, CanonicalSchema]
      def satisfiability: () -> satisfiability
      def inspect: () -> String
      def ==: (untyped other) -> bool
      def eql?: (untyped other) -> bool
      def hash: () -> Integer
    end

    # Accepts every value.
    class TrueView
    end

    # Rejects every value.
    class FalseView
    end

    # Accepts a value whose JSON type is in `types`.
    class MultiTypeView
      def types: () -> Array[Symbol]
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # Accepts a value of JSON type `type_name` that `body` accepts.
    class TypedGroupView
      def type_name: () -> Symbol
      def body: () -> CanonicalSchema
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # A string within `min_length`..`max_length`, matching every listed constraint and none of the excluded ones.
    class StringView
      def min_length: () -> Integer?
      def max_length: () -> Integer?
      def patterns: () -> Array[String]
      def excluded_patterns: () -> Array[String]
      def formats: () -> Array[String]
      def excluded_formats: () -> Array[String]
      def content_media_types: () -> Array[String]
      def content_encodings: () -> Array[String]
      def excluded: () -> Array[String]
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # A number value within a real interval.
    class NumberView
      def minimum: () -> Numeric?
      def exclusive_minimum: () -> bool
      def maximum: () -> Numeric?
      def exclusive_maximum: () -> bool
      def multiple_of: () -> Array[Numeric]
      def not_multiple_of: () -> Array[Numeric]
      def excludes_integers: () -> bool
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # An integer within `minimum`..`maximum`, a multiple of every `multiple_of` and of no `not_multiple_of` divisor.
    class IntegerView
      def minimum: () -> Integer?
      def maximum: () -> Integer?
      def multiple_of: () -> Array[Numeric]
      def not_multiple_of: () -> Array[Numeric]
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # An array value's constraints.
    class ArrayView
      def min_items: () -> Integer?
      def max_items: () -> Integer?
      def distinctness: () -> distinctness
      def prefix_items: () -> Array[CanonicalSchema]
      def items: () -> CanonicalSchema?
      def contains: () -> Array[ContainsView]
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # One `contains` requirement of an array; an absent minimum means the default of one.
    class ContainsView
      def schema: () -> CanonicalSchema
      def min_contains: () -> Integer?
      def max_contains: () -> Integer?
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # An object value's constraints.
    class ObjectView
      def min_properties: () -> Integer?
      def max_properties: () -> Integer?
      def required: () -> Array[String]
      def property_names: () -> CanonicalSchema?
      def properties: () -> Hash[String, CanonicalSchema]
      def pattern_properties: () -> Hash[String, CanonicalSchema]
      def additional_properties: () -> CanonicalSchema?
      def violations: () -> Array[NameFailsView | UndeclaredValueFailsView | PatternValueFailsView]
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # Some key's name fails the schema.
    class NameFailsView
      def schema: () -> CanonicalSchema
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # Some key outside `names` and matching none of `patterns` has a value failing `additional`.
    class UndeclaredValueFailsView
      def names: () -> Array[String]
      def patterns: () -> Array[String]
      def additional: () -> CanonicalSchema
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # Some key matching `pattern` has a value failing `schema`.
    class PatternValueFailsView
      def pattern: () -> String
      def schema: () -> CanonicalSchema
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # Accepts the values `schema` rejects, keeping the references it names symbolic.
    class NotView
      def schema: () -> CanonicalSchema
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # Accepts a value every branch accepts.
    class AllOfView
      def branches: () -> Array[CanonicalSchema]
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # Accepts a value exactly one branch accepts.
    class OneOfView
      def branches: () -> Array[CanonicalSchema]
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # The target a `$ref` names.
    class ReferenceView
      def uri: () -> String
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # Accepts a value any branch accepts.
    class AnyOfView
      def branches: () -> Array[CanonicalSchema]
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # Exactly one accepted value.
    class ConstView
      def value: () -> untyped
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # A sorted, deduplicated finite set of accepted values.
    class EnumView
      def values: () -> Array[untyped]
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # A schema the canonical form does not support structurally, kept verbatim.
    class RawView
      def schema: () -> untyped
      def reason: () -> raw_reason
      def pointer: () -> String?
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # One part of a schema object, as a reason names it.
    class Cause
      # JSON Pointer of the schema object holding `keywords`, or of the subschema itself.
      def pointer: () -> String
      # Keywords of one family present at `pointer`; empty for a whole subschema.
      def keywords: () -> Array[String]
      def ==: (untyped other) -> bool
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # The subschema is written as `false`.
    class LiteralReason
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # One required part accepts no value; a subschema part is also reported under its own pointer.
    class EmptyReason
      def cause: () -> Cause
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # Each part accepts values; no value satisfies all of them together.
    class ConflictReason
      def causes: () -> Array[Cause]
      def inspect: () -> String
      def deconstruct_keys: (untyped keys) -> Hash[Symbol, untyped]
    end

    # Why a subschema accepts no value.
    type unsatisfiable_reason = LiteralReason | EmptyReason | ConflictReason

    # The subschemas that accept no value, keyed by JSON Pointer, with the reason for each.
    #
    # A pointer left out is not proven satisfiable: a document the canonical form does not model
    # reports nothing, as `satisfiability` answers `:unknown`.
    def self.find_unsatisfiable: (
      untyped schema,
      ?draft: JSONSchema::draft?,
      ?validate_formats: bool?,
      ?pattern_options: (RegexOptions | FancyRegexOptions)?,
      ?retriever: (^(String) -> untyped)?,
      ?registry: Registry?,
      ?base_uri: String?
    ) -> Hash[String, unsatisfiable_reason]
  end

  # Reduce a schema to its canonical form.
  def self.canonicalize: (
    untyped schema,
    ?draft: draft?,
    ?validate_formats: bool?,
    ?pattern_options: (RegexOptions | FancyRegexOptions)?,
    ?retriever: (^(String) -> untyped)?,
    ?registry: Registry?,
    ?base_uri: String?
  ) -> Canonical::CanonicalSchema

  # A `format` check that reads numbers, for the `formats` option; other instances pass it.
  def self.number_format: (^(Numeric) -> bool check) -> NumberFormat

  # A `format` check that reads numbers, made by `JSONSchema.number_format`.
  class NumberFormat
  end

  # The names of the formats with a check under `draft`, sorted and without duplicates: the
  # built-in formats and those in `formats`.
  def self.known_formats: (draft draft, ?formats: Hash[String, (^(String) -> bool) | NumberFormat]?) -> Array[String]

  # Create a validator with auto-detected draft version.
  def self.validator_for: (
    untyped schema,
    ?validate_formats: bool?,
    ?ignore_unknown_formats: bool?,
    ?vocabularies: Array[String]?,
    ?base_uri: String?,
    ?retriever: (^(String) -> untyped)?,
    ?mask: String?,
    ?formats: Hash[String, (^(String) -> bool) | NumberFormat]?,
    ?keywords: Hash[String, Class]?,
    ?registry: Registry?,
    ?pattern_options: (RegexOptions | FancyRegexOptions)?,
    ?email_options: EmailOptions?,
    ?http_options: HttpOptions?,
    ?offline: bool?
  ) -> Validator

  # Create a map of validators for all sub-schemas in a JSON Schema.
  def self.validator_map_for: (
    untyped schema,
    ?validate_formats: bool?,
    ?ignore_unknown_formats: bool?,
    ?vocabularies: Array[String]?,
    ?mask: ::String?,
    ?base_uri: ::String?,
    ?retriever: (^(::String) -> untyped)?,
    ?registry: Registry?,
    ?formats: ::Hash[::String, ^(::String) -> bool]?,
    ?keywords: ::Hash[::String, untyped]?,
    ?pattern_options: (RegexOptions | FancyRegexOptions)?,
    ?email_options: EmailOptions?,
    ?http_options: HttpOptions?,
    ?offline: bool?
  ) -> ValidatorMap

  # Bundle a JSON Schema into a Compound Schema Document.
  # All externally-referenced schemas reachable via $ref are embedded in a
  # draft-appropriate container (definitions for Draft 4/6/7, $defs for
  # Draft 2019-09/2020-12).
  # Original $ref values are preserved unchanged.
  def self.bundle: (
    untyped schema,
    ?draft: draft?,
    ?retriever: (^(String) -> untyped)?,
    ?registry: Registry?,
    ?base_uri: String?,
    ?http_options: HttpOptions?,
    ?offline: bool?
  ) -> Hash[String, untyped]

  # Dereference a JSON Schema by recursively replacing all $ref values
  # with the schemas they point to.
  def self.dereference: (
    untyped schema,
    ?draft: draft?,
    ?retriever: (^(String) -> untyped)?,
    ?registry: Registry?,
    ?base_uri: String?,
    ?http_options: HttpOptions?,
    ?offline: bool?
  ) -> untyped

  # Detect the JSON Schema draft for a schema and return the corresponding validator class.
  # Draft is detected automatically from the `$schema` field. Defaults to Draft202012Validator.
  def self.validator_cls_for: (untyped schema) -> (singleton(Draft4Validator) | singleton(Draft6Validator) | singleton(Draft7Validator) | singleton(Draft201909Validator) | singleton(Draft202012Validator))

  # One-off validation returning boolean.
  def self.valid?: (
    untyped schema,
    untyped instance,
    ?draft: draft?,
    ?validate_formats: bool?,
    ?ignore_unknown_formats: bool?,
    ?vocabularies: Array[String]?,
    ?base_uri: String?,
    ?retriever: (^(String) -> untyped)?,
    ?mask: String?,
    ?formats: Hash[String, (^(String) -> bool) | NumberFormat]?,
    ?keywords: Hash[String, Class]?,
    ?registry: Registry?,
    ?pattern_options: (RegexOptions | FancyRegexOptions)?,
    ?email_options: EmailOptions?,
    ?http_options: HttpOptions?,
    ?offline: bool?
  ) -> bool

  # One-off validation raising on error.
  def self.validate!: (
    untyped schema,
    untyped instance,
    ?draft: draft?,
    ?validate_formats: bool?,
    ?ignore_unknown_formats: bool?,
    ?vocabularies: Array[String]?,
    ?base_uri: String?,
    ?retriever: (^(String) -> untyped)?,
    ?mask: String?,
    ?formats: Hash[String, (^(String) -> bool) | NumberFormat]?,
    ?keywords: Hash[String, Class]?,
    ?registry: Registry?,
    ?pattern_options: (RegexOptions | FancyRegexOptions)?,
    ?email_options: EmailOptions?,
    ?http_options: HttpOptions?,
    ?offline: bool?
  ) -> nil

  # Iterate validation errors. Returns Array when no block given, nil when block given.
  def self.each_error: (
    untyped schema,
    untyped instance,
    ?draft: draft?,
    ?validate_formats: bool?,
    ?ignore_unknown_formats: bool?,
    ?vocabularies: Array[String]?,
    ?base_uri: String?,
    ?retriever: (^(String) -> untyped)?,
    ?mask: String?,
    ?formats: Hash[String, (^(String) -> bool) | NumberFormat]?,
    ?keywords: Hash[String, Class]?,
    ?registry: Registry?,
    ?pattern_options: (RegexOptions | FancyRegexOptions)?,
    ?email_options: EmailOptions?,
    ?http_options: HttpOptions?,
    ?offline: bool?
  ) -> Array[ValidationError]
                      | (
    untyped schema,
    untyped instance,
    ?draft: draft?,
    ?validate_formats: bool?,
    ?ignore_unknown_formats: bool?,
    ?vocabularies: Array[String]?,
    ?base_uri: String?,
    ?retriever: (^(String) -> untyped)?,
    ?mask: String?,
    ?formats: Hash[String, (^(String) -> bool) | NumberFormat]?,
    ?keywords: Hash[String, Class]?,
    ?registry: Registry?,
    ?pattern_options: (RegexOptions | FancyRegexOptions)?,
    ?email_options: EmailOptions?,
    ?http_options: HttpOptions?,
    ?offline: bool?
  ) { (ValidationError) -> void } -> nil

  # One-off evaluation returning structured output.
  def self.evaluate: (
    untyped schema,
    untyped instance,
    ?draft: draft?,
    ?validate_formats: bool?,
    ?ignore_unknown_formats: bool?,
    ?vocabularies: Array[String]?,
    ?mask: String?,
    ?base_uri: String?,
    ?retriever: (^(String) -> untyped)?,
    ?formats: Hash[String, (^(String) -> bool) | NumberFormat]?,
    ?keywords: Hash[String, Class]?,
    ?registry: Registry?,
    ?pattern_options: (RegexOptions | FancyRegexOptions)?,
    ?email_options: EmailOptions?,
    ?http_options: HttpOptions?,
    ?offline: bool?
  ) -> Evaluation

  private
  # Reusable JSON Schema validator.
  class Validator
    # The draft classes take the schema and the `validator_for` keyword arguments.
    def initialize: (
      untyped schema,
      ?validate_formats: bool?,
      ?ignore_unknown_formats: bool?,
      ?vocabularies: Array[String]?,
      ?base_uri: String?,
      ?retriever: (^(String) -> untyped)?,
      ?mask: String?,
      ?formats: Hash[String, (^(String) -> bool) | NumberFormat]?,
      ?keywords: Hash[String, Class]?,
      ?registry: Registry?,
      ?pattern_options: (RegexOptions | FancyRegexOptions)?,
      ?email_options: EmailOptions?,
      ?http_options: HttpOptions?,
      ?offline: bool?
    ) -> void

    # Fast validation returning boolean.
    def valid?: (untyped instance) -> bool

    # Validate and raise on first error.
    def validate!: (untyped instance) -> nil

    # Iterate validation errors. Returns Array when no block given, nil when block given.
    def each_error: (untyped instance) -> Array[ValidationError]
                  | (untyped instance) { (ValidationError) -> void } -> nil

    # Evaluate instance and return structured output.
    def evaluate: (untyped instance) -> Evaluation

    def inspect: () -> String
  end

  # Validates instances given as JSON text, without building Ruby objects for them.
  class JsonTextValidator
    def initialize: (
      untyped schema,
      ?draft: draft?,
      ?validate_formats: bool?,
      ?ignore_unknown_formats: bool?,
      ?vocabularies: Array[String]?,
      ?base_uri: String?,
      ?retriever: (^(String) -> untyped)?,
      ?mask: String?,
      ?formats: Hash[String, (^(String) -> bool) | NumberFormat]?,
      ?keywords: Hash[String, Class]?,
      ?registry: Registry?,
      ?pattern_options: (RegexOptions | FancyRegexOptions)?,
      ?email_options: EmailOptions?,
      ?http_options: HttpOptions?,
      ?offline: bool?
    ) -> void

    # Whether the JSON text holds a valid document.
    def valid?: (String text) -> bool

    # Raise on the first error of the document in the JSON text.
    def validate!: (String text) -> nil

    # Iterate validation errors. Returns Array when no block given, nil when block given.
    def each_error: (String text) -> Array[ValidationError]
                  | (String text) { (ValidationError) -> void } -> nil

    # Evaluate the document in the JSON text and return structured output.
    def evaluate: (String text) -> Evaluation

    def inspect: () -> String
  end
  public

  # Validators for every subschema, keyed by URI fragment such as `"#/$defs/User"`.
  class ValidatorMap
    def []: (::String pointer) -> Validator?
    def fetch: (::String pointer) -> Validator
    def key?: (::String pointer) -> bool
    def keys: () -> ::Array[::String]
    def length: () -> ::Integer
    def size: () -> ::Integer
  end

  # JSON Schema Draft 4 validator.
  class Draft4Validator < Validator
  end

  # JSON Schema Draft 6 validator.
  class Draft6Validator < Validator
  end

  # JSON Schema Draft 7 validator.
  class Draft7Validator < Validator
  end

  # JSON Schema Draft 2019-09 validator.
  class Draft201909Validator < Validator
  end

  # JSON Schema Draft 2020-12 validator.
  class Draft202012Validator < Validator
  end

  # Validation error with detailed information.
  class ValidationError < StandardError
    # Brief error message.
    attr_reader message: String

    # Detailed error message with full context.
    attr_reader verbose_message: String

    # Path to the failing instance location.
    attr_reader instance_path: Array[String | Integer]

    # Path to the failing schema location.
    attr_reader schema_path: Array[String | Integer]

    attr_reader evaluation_path: Array[String | Integer]

    # The specific kind of validation error.
    attr_reader kind: ValidationErrorKind

    # The failing instance value.
    attr_reader instance: untyped

    # Absolute URI of the failing keyword; nil when its resource has no base URI.
    attr_reader absolute_keyword_location: String?

    def initialize: (?String message) -> void

    def to_s: () -> String
    def inspect: () -> String

    # Compare two validation errors by message, schema_path, and instance_path.
    def ==: (untyped other) -> bool
    alias eql? ==

    # Hash code based on message, schema_path, and instance_path.
    def hash: () -> Integer

    # `instance_path` as a JSON Pointer (RFC 6901).
    def instance_path_pointer: () -> String

    # `schema_path` as a JSON Pointer (RFC 6901).
    def schema_path_pointer: () -> String

    # `evaluation_path` as a JSON Pointer (RFC 6901).
    def evaluation_path_pointer: () -> String
  end

  # Type of validation error with contextual data.
  class ValidationErrorKind
    # Keyword name that caused the error (e.g., "type", "required", "format").
    def name: () -> String

    # Associated value for the error (varies by error type).
    def value: () -> untyped

    # Convert to hash representation.
    def to_h: () -> Hash[Symbol, untyped]

    def inspect: () -> String
    def to_s: () -> String
  end

  # Structured evaluation output following JSON Schema specification.
  class Evaluation
    # Whether the instance is valid.
    def valid?: () -> bool

    # Flag output format (simplest).
    # Returns { valid: true/false }
    def flag: () -> Hash[Symbol, untyped]

    # List output format (flat).
    # Contains { valid: bool, details: [...] }
    def list: () -> Hash[Symbol, untyped]

    # Hierarchical output format (nested).
    # Contains nested structure following schema hierarchy
    def hierarchical: () -> Hash[Symbol, untyped]

    # Collected annotations from all evaluated nodes.
    # Each entry contains schemaLocation, absoluteKeywordLocation, instanceLocation and annotations
    def annotations: () -> Array[Hash[Symbol, untyped]]

    # Collected errors from all evaluated nodes.
    # Each entry contains schemaLocation, instanceLocation, error, and absoluteKeywordLocation
    def errors: () -> Array[Hash[Symbol, untyped]]

    def inspect: () -> String
  end

  # Resolver for JSON Schema references.
  class Resolver
    def base_uri: () -> String
    def dynamic_scope: () -> Array[String]
    def lookup: (String reference) -> Resolved
    def lookup_dynamic_ref: (String reference) -> Resolved
  end

  # Resolved reference containing the dereferenced schema and its context.
  class Resolved
    def contents: () -> untyped
    def resolver: () -> Resolver
    def draft: () -> Integer
  end

  # Schema registry for reference resolution.
  class Registry
    # Create a registry from URI/schema pairs.
    # @param resources Array of [uri, schema] pairs
    # @param draft Default draft symbol, such as :draft7
    # @param retriever Proc that fetches schemas for URIs not in `resources`
    def initialize: (Array[[String, untyped]] resources, ?draft: draft?, ?retriever: (^(String) -> untyped)?) -> void

    # Resolver for references against `base_uri`.
    def resolver: (String base_uri) -> Resolver

    def inspect: () -> String
  end

  # Raised when a reference cannot be resolved.
  class ReferencingError < StandardError
    attr_reader message: String
    def initialize: (String message) -> void
  end

  # Meta-schema validation.
  module Meta
    # Validate a schema against its meta-schema.
    def self.valid?: (untyped schema, ?registry: Registry?) -> bool

    # Validate a schema and raise on error.
    def self.validate!: (untyped schema, ?registry: Registry?) -> nil
  end

  # Email format validation options.
  class EmailOptions
    # Create email validation options.
    # @param require_tld Require top-level domain (default: false)
    # @param allow_domain_literal Allow domain literals like [127.0.0.1] (default: true)
    # @param allow_display_text Allow display names like "Name <email>" (default: true)
    # @param minimum_sub_domains Minimum number of domain segments (default: nil)
    def initialize: (
      ?require_tld: bool?,
      ?allow_domain_literal: bool?,
      ?allow_display_text: bool?,
      ?minimum_sub_domains: Integer?
    ) -> void

    # Whether TLD is required.
    def require_tld: () -> bool

    # Whether domain literals are allowed.
    def allow_domain_literal: () -> bool

    # Whether display text is allowed.
    def allow_display_text: () -> bool

    # Minimum number of domain segments.
    def minimum_sub_domains: () -> Integer?

    def inspect: () -> String
    def to_s: () -> String
  end

  # Regex engine options.
  class RegexOptions
    # Create regex engine options.
    # @param size_limit Maximum compiled regex size in bytes
    # @param dfa_size_limit Maximum DFA size in bytes
    # @param syntax :ecma262 translates patterns for the engine, :engine passes them to it unchanged
    def initialize: (
      ?size_limit: Integer?,
      ?dfa_size_limit: Integer?,
      ?syntax: (:ecma262 | :engine)?
    ) -> void

    # Syntax patterns are written in.
    def syntax: () -> (:ecma262 | :engine)

    # Maximum compiled regex size.
    def size_limit: () -> Integer?

    # Maximum DFA size.
    def dfa_size_limit: () -> Integer?

    def inspect: () -> String
    def to_s: () -> String
  end

  # fancy-regex engine options: backtracking, with lookaround and backreferences.
  class FancyRegexOptions
    # Create fancy regex engine options.
    # @param backtrack_limit Maximum backtracking steps
    # @param size_limit Maximum compiled regex size
    # @param dfa_size_limit Maximum DFA size
    # @param syntax :ecma262 translates patterns for the engine, :engine passes them to it unchanged
    def initialize: (
      ?backtrack_limit: Integer?,
      ?size_limit: Integer?,
      ?dfa_size_limit: Integer?,
      ?syntax: (:ecma262 | :engine)?
    ) -> void

    # Syntax patterns are written in.
    def syntax: () -> (:ecma262 | :engine)

    # Maximum backtracking steps.
    def backtrack_limit: () -> Integer?

    # Maximum compiled regex size.
    def size_limit: () -> Integer?

    # Maximum DFA size.
    def dfa_size_limit: () -> Integer?

    def inspect: () -> String
    def to_s: () -> String
  end

  # HTTP client options for remote schema retrieval.
  class HttpOptions
    # Create HTTP client options.
    # @param timeout Request timeout in seconds
    # @param connect_timeout Connection timeout in seconds
    # @param tls_verify Verify TLS certificates (default: true)
    # @param ca_cert Path to CA certificate file
    def initialize: (
      ?timeout: Float?,
      ?connect_timeout: Float?,
      ?tls_verify: bool?,
      ?ca_cert: String?
    ) -> void

    # Request timeout in seconds.
    def timeout: () -> Float?

    # Connection timeout in seconds.
    def connect_timeout: () -> Float?

    # Whether to verify TLS certificates.
    def tls_verify: () -> bool

    # Path to CA certificate file.
    def ca_cert: () -> String?

    def inspect: () -> String
    def to_s: () -> String
  end
end
