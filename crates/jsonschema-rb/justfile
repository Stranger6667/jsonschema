# Build the native extension and the compiled test-suite validators
build:
    JSONSCHEMA_RB_CODEGEN_SUITE=1 bundle exec rake compile

# Run tests
test: build
    bundle exec rspec

# Lint Ruby code
lint:
    bundle exec rubocop

# Clean build artifacts
clean:
    bundle exec rake clean

# Install dependencies
setup:
    bundle install

# Run benchmarks, including the compiled validators
bench:
    JSONSCHEMA_RB_CODEGEN_BENCH=1 bundle exec rake compile
    bundle exec ruby bench/benchmark.rb
